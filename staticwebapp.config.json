{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/*.{png,jpg,jpeg,gif,ico,svg,webp,css,js,woff,woff2,ttf,eot,json}"
    ]
  },
  "platform": {
    "apiRuntime": "node:20"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
